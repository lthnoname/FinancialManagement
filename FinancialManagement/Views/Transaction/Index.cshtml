@model IEnumerable<FinancialManagement.Models.Transaction>
@{
    ViewData["Title"] = "Quản lý Giao dịch - FinanceApp";
    var categories = ViewBag.Categories as List<FinancialManagement.Models.Category> ?? new List<FinancialManagement.Models.Category>();
    decimal totalIncome = ViewBag.TotalIncome ?? 0;
    decimal totalExpense = ViewBag.TotalExpense ?? 0;
    decimal netBalance = ViewBag.NetBalance ?? 0;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #0f2d37;">
                <i class="bi bi-arrow-left-right text-primary me-2"></i>Quản lý Giao dịch
            </h3>
            <p class="text-muted mb-0" style="font-size: 14px;">
                Ghi chép và theo dõi chi tiết từng khoản thu và chi tiêu hàng ngày.
            </p>
        </div>
        <div>
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 fw-semibold"
                    style="background-color: var(--primary-teal); border: none; border-radius: 10px;"
                    data-bs-toggle="modal" data-bs-target="#createTransactionModal">
                <i class="bi bi-plus-lg"></i> Thêm giao dịch mới
            </button>
        </div>
    </div>

    <!-- Thông báo kết quả -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3" role="alert" style="border-radius: 10px;">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-3" role="alert" style="border-radius: 10px;">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thẻ tóm tắt số liệu nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 14px; background: #f0fdf4; border-left: 5px solid #16a34a !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold">TỔNG THU NHẬP</span>
                        <h4 class="fw-bold text-success mt-1 mb-0">+@totalIncome.ToString("N0") đ</h4>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-success text-white" style="width: 44px; height: 44px;">
                        <i class="bi bi-arrow-down-left fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 14px; background: #fef2f2; border-left: 5px solid #dc2626 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold">TỔNG CHI TIÊU</span>
                        <h4 class="fw-bold text-danger mt-1 mb-0">-@totalExpense.ToString("N0") đ</h4>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-danger text-white" style="width: 44px; height: 44px;">
                        <i class="bi bi-arrow-up-right fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 14px; background: #eff6ff; border-left: 5px solid #2563eb !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold">CHÊNH LỆCH RÒNG</span>
                        <h4 class="fw-bold @(netBalance >= 0 ? "text-primary" : "text-danger") mt-1 mb-0">
                            @(netBalance >= 0 ? "+" : "")@netBalance.ToString("N0") đ
                        </h4>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white" style="width: 44px; height: 44px;">
                        <i class="bi bi-wallet2 fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bộ lọc tìm kiếm -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Từ ngày</label>
                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Đến ngày</label>
                    <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Loại</label>
                    <select name="type" class="form-select form-select-sm">
                        <option value="">Tất cả</option>
                        <option value="E" selected="@(ViewBag.SelectedType == "E")">Chi tiêu</option>
                        <option value="I" selected="@(ViewBag.SelectedType == "I")">Thu nhập</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Danh mục</label>
                    <select name="categoryId" class="form-select form-select-sm">
                        <option value="">Tất cả danh mục</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryId" selected="@(ViewBag.SelectedCategoryId == cat.CategoryId)">
                                [@(cat.Type == "I" ? "Thu" : "Chi")] @cat.CategoryName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1" style="background-color: var(--primary-teal); border: none;">
                        <i class="bi bi-funnel"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Đặt lại">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách giao dịch -->
    <div class="card border-0 shadow-sm" style="border-radius: 14px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Ngày</th>
                            <th>Danh mục</th>
                            <th>Ghi chú</th>
                            <th class="text-end">Số tiền</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt fs-1 d-block mb-2 text-secondary"></i>
                                    Không có giao dịch nào trong khoảng thời gian này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold text-dark">@item.TransactionDate.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@item.TransactionDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (item.Type == "I")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="bi bi-arrow-down-left me-1"></i>@(item.Category?.CategoryName ?? "Thu nhập")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                    <i class="bi bi-arrow-up-right me-1"></i>@(item.Category?.CategoryName ?? "Chi tiêu")
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted text-break">@(string.IsNullOrEmpty(item.Note) ? "-" : item.Note)</span>
                                    </td>
                                    <td class="text-end fw-bold fs-6 @(item.Type == "I" ? "text-success" : "text-danger")">
                                        @(item.Type == "I" ? "+" : "-")@item.Amount.ToString("N0") đ
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button type="button" class="btn btn-sm btn-light text-primary"
                                                    onclick="openEditModal(@item.TransactionId, @item.CategoryId, @item.Amount, '@item.TransactionDate.ToString("yyyy-MM-ddTHH:mm")', '@Html.Raw(item.Note?.Replace("'", "\\'"))', '@item.Type')"
                                                    title="Sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-light text-danger"
                                                    onclick="openDeleteModal(@item.TransactionId, '@item.TransactionDate.ToString("dd/MM/yyyy")', '@item.Amount.ToString("N0") đ')"
                                                    title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Giao dịch -->
<div class="modal fade" id="createTransactionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">Thêm giao dịch mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Loại giao dịch</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="createTypeFilter" id="createTypeExpense" value="E" checked onchange="filterCreateCategories()">
                            <label class="btn btn-outline-danger" for="createTypeExpense"><i class="bi bi-arrow-up-right me-1"></i> Chi tiêu</label>

                            <input type="radio" class="btn-check" name="createTypeFilter" id="createTypeIncome" value="I" onchange="filterCreateCategories()">
                            <label class="btn btn-outline-success" for="createTypeIncome"><i class="bi bi-arrow-down-left me-1"></i> Thu nhập</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Danh mục <span class="text-danger">*</span></label>
                        <select name="categoryId" id="createCategoryId" class="form-select" required>
                            <option value="">-- Chọn danh mục --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.CategoryId" data-type="@c.Type">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Số tiền (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" step="1000" min="1000" name="amount" class="form-control" placeholder="Ví dụ: 50000" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Thời gian giao dịch</label>
                        <input type="datetime-local" name="transactionDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú</label>
                        <textarea name="note" rows="2" class="form-control" placeholder="Ghi chú chi tiết (nếu có)"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary" style="background-color: var(--primary-teal); border: none;">Lưu giao dịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Giao dịch -->
<div class="modal fade" id="editTransactionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="transactionId" id="editTransactionId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">Chỉnh sửa giao dịch</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Danh mục <span class="text-danger">*</span></label>
                        <select name="categoryId" id="editCategoryId" class="form-select" required>
                            @foreach (var c in categories)
                            {
                                <option value="@c.CategoryId" data-type="@c.Type">[@(c.Type == "I" ? "Thu" : "Chi")] @c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Số tiền (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" step="1000" min="1000" name="amount" id="editAmount" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Thời gian giao dịch</label>
                        <input type="datetime-local" name="transactionDate" id="editTransactionDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú</label>
                        <textarea name="note" id="editNote" rows="2" class="form-control"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary" style="background-color: var(--primary-teal); border: none;">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Xóa -->
<div class="modal fade" id="deleteTransactionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="transactionId" id="deleteTransactionId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">Xác nhận xóa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Bạn có chắc chắn muốn xóa giao dịch ngày <strong id="deleteDateText"></strong> với số tiền <strong id="deleteAmountText"></strong> không?
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xóa giao dịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterCreateCategories() {
            const selectedType = document.querySelector('input[name="createTypeFilter"]:checked').value;
            const select = document.getElementById('createCategoryId');
            const options = select.querySelectorAll('option[data-type]');

            let firstVisible = null;
            options.forEach(opt => {
                if (opt.getAttribute('data-type') === selectedType) {
                    opt.style.display = '';
                    if (!firstVisible) firstVisible = opt;
                } else {
                    opt.style.display = 'none';
                }
            });

            if (firstVisible) {
                select.value = firstVisible.value;
            } else {
                select.value = '';
            }
        }

        function openEditModal(id, categoryId, amount, date, note, type) {
            document.getElementById('editTransactionId').value = id;
            document.getElementById('editCategoryId').value = categoryId;
            document.getElementById('editAmount').value = amount;
            document.getElementById('editTransactionDate').value = date;
            document.getElementById('editNote').value = note;
            new bootstrap.Modal(document.getElementById('editTransactionModal')).show();
        }

        function openDeleteModal(id, date, amount) {
            document.getElementById('deleteTransactionId').value = id;
            document.getElementById('deleteDateText').innerText = date;
            document.getElementById('deleteAmountText').innerText = amount;
            new bootstrap.Modal(document.getElementById('deleteTransactionModal')).show();
        }

        document.addEventListener("DOMContentLoaded", function () {
            filterCreateCategories();
        });
    </script>
}