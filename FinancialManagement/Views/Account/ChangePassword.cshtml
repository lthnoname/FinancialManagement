@model FinancialManagement.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu - FinanceApp";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 56px; height: 56px;">
                        <i class="bi bi-shield-lock fs-3 text-teal"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">Đổi mật khẩu</h4>
                    <p class="text-muted small">Cập nhật mật khẩu để bảo vệ an toàn cho tài khoản</p>
                </div>

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold small text-muted">Mật khẩu hiện tại</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                            <input asp-for="CurrentPassword" class="form-control bg-light border-start-0" placeholder="Nhập mật khẩu hiện tại" />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small text-muted">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="NewPassword" class="form-control bg-light border-start-0" placeholder="Tối thiểu 6 ký tự" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-muted">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-check2-circle text-muted"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control bg-light border-start-0" placeholder="Nhập lại mật khẩu mới" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold" style="background-color: var(--primary-teal); border: none; border-radius: 10px;">
                            <i class="bi bi-check-lg me-1"></i> Lưu mật khẩu mới
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light py-2 fw-semibold text-muted" style="border-radius: 10px;">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}