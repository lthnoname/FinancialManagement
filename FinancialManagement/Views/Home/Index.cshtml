@model FinancialManagement.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan tài chính - Dashboard";
    var fullNameClaim = User.FindFirst("FullName")?.Value;
    var displayName = !string.IsNullOrEmpty(fullNameClaim) ? fullNameClaim : (User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Người dùng");
}

<!-- Top Welcome Banner -->
<div class="dashboard-welcome-banner mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h2><i class="bi bi-stars me-2"></i>Xin chào, @displayName!</h2>
            <p class="mb-0">
                Chào mừng bạn trở lại với <strong>FinanceApp</strong>. 
                @if (Model.balanceGrowthRate >= 0)
                {
                    <span>Tăng trưởng ròng tháng này đạt <strong class="text-white">+@Model.balanceGrowthRate%</strong> so với tháng trước.</span>
                }
                else
                {
                    <span>Tăng trưởng ròng tháng này giảm <strong class="text-white">@Model.balanceGrowthRate%</strong> so với tháng trước.</span>
                }
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-light fw-bold text-dark d-flex align-items-center gap-2" style="border-radius: 10px; font-size: 13.5px;" data-bs-toggle="modal" data-bs-target="#newTransactionModal">
                <i class="bi bi-plus-circle-fill text-success"></i> Thêm giao dịch
            </button>
            <a asp-controller="Transaction" asp-action="ExportCsv" class="btn btn-outline-light d-flex align-items-center gap-2" style="border-radius: 10px; font-size: 13.5px;">
                <i class="bi bi-file-earmark-excel"></i> Xuất CSV
            </a>
        </div>
    </div>
</div>

<!-- 4 Thẻ chỉ số chính (Dữ liệu thật) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Tổng số dư khả dụng -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Tổng số dư khả dụng</span>
                <div class="stat-icon-wrapper stat-icon-blue">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <div class="stat-card-value @(Model.TotalBalance >= 0 ? "text-dark" : "text-danger")">
                @Model.TotalBalance.ToString("N0") ₫
            </div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="stat-trend-badge @(Model.balanceGrowthRate >= 0 ? "trend-up" : "trend-down")">
                    <i class="bi @(Model.balanceGrowthRate >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                    @(Model.balanceGrowthRate >= 0 ? "+" : "")@Model.balanceGrowthRate%
                </span>
                <span class="text-muted" style="font-size: 12px;">So với tháng trước</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Thu nhập tháng này -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Thu nhập tháng này</span>
                <div class="stat-icon-wrapper stat-icon-green">
                    <i class="bi bi-arrow-down-left-circle-fill"></i>
                </div>
            </div>
            <div class="stat-card-value text-success">+@Model.MonthlyIncome.ToString("N0") ₫</div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="stat-trend-badge @(Model.incomeGrowthRate >= 0 ? "trend-up" : "trend-down")">
                    <i class="bi @(Model.incomeGrowthRate >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                    @(Model.incomeGrowthRate >= 0 ? "+" : "")@Model.incomeGrowthRate%
                </span>
                <span class="text-muted" style="font-size: 12px;">@Model.IncomeCount khoản thu</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Chi tiêu tháng này -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Chi tiêu tháng này</span>
                <div class="stat-icon-wrapper stat-icon-red">
                    <i class="bi bi-arrow-up-right-circle-fill"></i>
                </div>
            </div>
            <div class="stat-card-value text-danger">-@Model.MonthlyExpense.ToString("N0") ₫</div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="stat-trend-badge trend-up">
                    <i class="bi bi-pie-chart"></i> @Model.ExpenseRatio.ToString("F1")% thu nhập
                </span>
                <span class="text-muted" style="font-size: 12px;">@Model.ExpenseCount khoản chi</span>
            </div>
        </div>
    </div>

    <!-- Card 4: Tích lũy tháng này -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Tích lũy tháng này</span>
                <div class="stat-icon-wrapper stat-icon-purple">
                    <i class="bi bi-piggy-bank-fill"></i>
                </div>
            </div>
            <div class="stat-card-value @(Model.MonthlySavings >= 0 ? "text-primary" : "text-danger")">
                @(Model.MonthlySavings >= 0 ? "+" : "")@Model.MonthlySavings.ToString("N0") ₫
            </div>
            <div>
                <span class="text-muted" style="font-size: 12px;">Thu nhập trừ chi tiêu tháng</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-3 mb-4">
    <!-- Biểu đồ dòng tiền 6 tháng gần nhất -->
    <div class="col-12 col-lg-8">
        <div class="dashboard-card">
            <div class="dashboard-card-title">
                <span><i class="bi bi-bar-chart-line text-primary me-2"></i>Biến động Thu - Chi 6 tháng gần nhất</span>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="cashFlowChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Biểu đồ cơ cấu chi tiêu tháng -->
    <div class="col-12 col-lg-4">
        <div class="dashboard-card">
            <div class="dashboard-card-title">
                <span><i class="bi bi-pie-chart text-info me-2"></i>Cơ cấu chi tiêu tháng</span>
            </div>
            <div style="height: 220px; position: relative;" class="d-flex justify-content-center">
                @if (Model.ExpenseCategoryAmounts.Any() && Model.ExpenseCategoryAmounts.Sum() > 0)
                {
                    <canvas id="expenseCategoryChart"></canvas>
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center text-muted h-100">
                        <i class="bi bi-inbox fs-1 mb-2"></i>
                        <span class="small">Chưa có dữ liệu chi tiêu tháng này</span>
                    </div>
                }
            </div>
            @if (Model.ExpenseCategoryLabels.Any())
            {
                <div class="mt-3 pt-2 border-top d-flex flex-wrap justify-content-around text-center" style="font-size: 12px; gap: 8px;">
                    @for (int i = 0; i < Math.Min(Model.ExpenseCategoryLabels.Count, 4); i++)
                    {
                        <div>
                            <span class="badge bg-light text-dark border mb-1">@Model.ExpenseCategoryLabels[i]</span><br>
                            <strong class="text-dark">@Model.ExpenseCategoryPercentages[i]%</strong>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Transactions & Quick Tools Section -->
<div class="row g-3">
    <!-- Recent Transactions Table (Dữ liệu thật) -->
    <div class="col-12 col-lg-8">
        <div class="dashboard-card">
            <div class="dashboard-card-title">
                <span><i class="bi bi-clock-history text-secondary me-2"></i>Giao dịch gần đây</span>
                <a asp-controller="Transaction" asp-action="Index" class="text-decoration-none fw-semibold" style="font-size: 13px; color: var(--primary-teal);">
                    Xem tất cả <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table transaction-table align-middle">
                    <thead>
                        <tr>
                            <th>Giao dịch / Ghi chú</th>
                            <th>Danh mục</th>
                            <th>Thời gian</th>
                            <th class="text-end">Số tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
                        {
                            foreach (var tx in Model.RecentTransactions)
                            {
                                bool isIncome = tx.Type == "I";
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="tx-icon-wrap" style="background: @(isIncome ? "#e6f4ea" : "#fce8e6"); color: @(isIncome ? "#137333" : "#c5221f");">
                                                <i class="bi @(isIncome ? "bi-cash-stack" : "bi-cart3")"></i>
                                            </div>
                                            <div>
                                                <div class="tx-name fw-semibold">@(string.IsNullOrEmpty(tx.Note) ? (isIncome ? "Khoản thu" : "Khoản chi") : tx.Note)</div>
                                                <div class="tx-category small text-muted">ID: #@tx.TransactionId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(isIncome ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger") border-0">
                                            @(tx.Category?.CategoryName ?? "Chưa phân loại")
                                        </span>
                                    </td>
                                    <td class="text-muted" style="font-size: 12.5px;">@tx.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end fw-bold @(isIncome ? "text-success" : "text-danger")">
                                        @(isIncome ? "+" : "-")@tx.Amount.ToString("N0") ₫
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-card-list fs-2 d-block mb-1"></i>
                                    Chưa có giao dịch nào được ghi lại.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Tools & Bank Cards -->
    <div class="col-12 col-lg-4">
        <!-- Quick Actions -->
        <div class="dashboard-card">
            <div class="dashboard-card-title">
                <span><i class="bi bi-lightning-charge text-warning me-2"></i>Thao tác nhanh</span>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <a href="javascript:void(0)" class="btn-quick-action" data-bs-toggle="modal" data-bs-target="#newTransactionModal">
                        <i class="bi bi-plus-circle"></i>
                        <span>Thêm giao dịch</span>
                    </a>
                </div>
                <div class="col-6">
                    <a asp-controller="Category" asp-action="Index" class="btn-quick-action">
                        <i class="bi bi-tags"></i>
                        <span>Xem danh mục</span>
                    </a>
                </div>
                <div class="col-6">
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn-quick-action">
                        <i class="bi bi-key"></i>
                        <span>Đổi mật khẩu</span>
                    </a>
                </div>
                <div class="col-6">
                    <a asp-controller="Transaction" asp-action="ExportCsv" class="btn-quick-action">
                        <i class="bi bi-download"></i>
                        <span>Xuất CSV</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Giao Dịch Nhanh (Sử dụng danh mục thật của User) -->
<div class="modal fade" id="newTransactionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color: #0f2d37;">Thêm giao dịch mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-controller="Transaction" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Số tiền (VNĐ)</label>
                        <input type="number" name="amount" class="form-control form-control-lg" placeholder="Ví dụ: 100000" min="1" step="any" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Danh mục</label>
                        <select name="categoryId" class="form-select" required>
                            @if (Model.Categories != null && Model.Categories.Any())
                            {
                                foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryId">
                                        [@(cat.Type == "I" ? "Thu nhập" : "Chi tiêu")] @cat.CategoryName
                                    </option>
                                }
                            }
                            else
                            {
                                <option value="">Chưa có danh mục nào</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Ngày giao dịch</label>
                        <input type="datetime-local" name="transactionDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Ghi chú giao dịch</label>
                        <input type="text" name="note" class="form-control" placeholder="Ví dụ: Ăn trưa với đồng nghiệp...">
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" style="background-color: var(--primary-teal); border: none; border-radius: 10px;">
                        Lưu giao dịch
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Dữ liệu thật từ Controller qua JSON Serialize
            const cashFlowLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashFlowLabels));
            const cashFlowIncomes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashFlowIncomes));
            const cashFlowExpenses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashFlowExpenses));

            // Render Biểu đồ Dòng tiền 6 tháng
            const cashFlowCanvas = document.getElementById('cashFlowChart');
            if (cashFlowCanvas) {
                const cashFlowCtx = cashFlowCanvas.getContext('2d');
                new Chart(cashFlowCtx, {
                    type: 'bar',
                    data: {
                        labels: cashFlowLabels,
                        datasets: [
                            {
                                label: 'Thu nhập',
                                data: cashFlowIncomes,
                                backgroundColor: '#176e82',
                                borderRadius: 6
                            },
                            {
                                label: 'Chi tiêu',
                                data: cashFlowExpenses,
                                backgroundColor: '#ef4444',
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    font: { family: 'Plus Jakarta Sans', size: 12 },
                                    usePointStyle: true
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + Number(context.parsed.y).toLocaleString('vi-VN') + ' ₫';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return Number(value).toLocaleString('vi-VN') + ' ₫';
                                    }
                                },
                                grid: { color: '#f1f5f9' }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // Render Biểu đồ Cơ cấu Chi tiêu (Doughnut)
            const expenseCategoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategoryLabels));
            const expenseCategoryAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategoryAmounts));
            const expenseCanvas = document.getElementById('expenseCategoryChart');

            if (expenseCanvas && expenseCategoryAmounts.length > 0) {
                const expenseCtx = expenseCanvas.getContext('2d');
                new Chart(expenseCtx, {
                    type: 'doughnut',
                    data: {
                        labels: expenseCategoryLabels,
                        datasets: [{
                            data: expenseCategoryAmounts,
                            backgroundColor: ['#176e82', '#f59e0b', '#06b6d4', '#ef4444', '#8b5cf6', '#10b981', '#94a3b8'],
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ' + Number(context.parsed).toLocaleString('vi-VN') + ' ₫';
                                    }
                                }
                            }
                        },
                        cutout: '70%'
                    }
                });
            }
        });
    </script>
}