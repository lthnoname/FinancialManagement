@{
    ViewData["Title"] = "Tổng quan tài chính - Dashboard";
    var fullNameClaim = User.FindFirst("FullName")?.Value;
    var displayName = !string.IsNullOrEmpty(fullNameClaim) ? fullNameClaim : (User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Khách hàng");
}

<!-- Top Welcome Banner -->
<div class="dashboard-welcome-banner">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h2><i class="bi bi-stars me-2"></i>Xin chào, @displayName!</h2>
            <p>Chào mừng bạn trở lại với hệ thống quản lý tài chính cá nhân <strong>FinanceApp</strong>. Dòng tiền tháng này đang tăng trưởng tốt (+12.5%).</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-light fw-bold text-dark d-flex align-items-center gap-2" style="border-radius: 10px; font-size: 13.5px;" data-bs-toggle="modal" data-bs-target="#newTransactionModal">
                <i class="bi bi-plus-circle-fill text-success"></i> Thêm giao dịch
            </button>
            <button type="button" class="btn btn-outline-light d-flex align-items-center gap-2" style="border-radius: 10px; font-size: 13.5px;" onclick="alert('Đang tải báo cáo tài chính tháng...')">
                <i class="bi bi-download"></i> Xuất PDF
            </button>
        </div>
    </div>
</div>

<!-- Key Stat Cards -->
<div class="row g-3 mb-4">
    <!-- Card 1: Tổng số dư -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Tổng số dư khả dụng</span>
                <div class="stat-icon-wrapper stat-icon-blue">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <div class="stat-card-value">1.250.000.000 ₫</div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="stat-trend-badge trend-up">
                    <i class="bi bi-arrow-up-short"></i> +12.5%
                </span>
                <span class="text-muted" style="font-size: 12px;">So với tháng trước</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Thu nhập tháng -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Thu nhập tháng này</span>
                <div class="stat-icon-wrapper stat-icon-green">
                    <i class="bi bi-arrow-down-left-circle-fill"></i>
                </div>
            </div>
            <div class="stat-card-value text-success">+128.500.000 ₫</div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="stat-trend-badge trend-up">
                    <i class="bi bi-arrow-up-short"></i> +8.2%
                </span>
                <span class="text-muted" style="font-size: 12px;">3 nguồn thu</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Chi tiêu tháng -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Chi tiêu tháng này</span>
                <div class="stat-icon-wrapper stat-icon-red">
                    <i class="bi bi-arrow-up-right-circle-fill"></i>
                </div>
            </div>
            <div class="stat-card-value text-danger">-45.200.000 ₫</div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="stat-trend-badge trend-up">
                    <i class="bi bi-shield-check"></i> 65% định mức
                </span>
                <span class="text-muted" style="font-size: 12px;">Tiết kiệm 35%</span>
            </div>
        </div>
    </div>

    <!-- Card 4: Quỹ tích lũy -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Quỹ tiết kiệm & Đầu tư</span>
                <div class="stat-icon-wrapper stat-icon-purple">
                    <i class="bi bi-piggy-bank-fill"></i>
                </div>
            </div>
            <div class="stat-card-value">245.000.000 ₫</div>
            <div>
                <div class="d-flex justify-content-between text-muted mb-1" style="font-size: 11.5px;">
                    <span>Mục tiêu: 300.000.000 ₫</span>
                    <span class="fw-bold text-dark">82%</span>
                </div>
                <div class="progress" style="height: 6px; border-radius: 4px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 82%; background-color: var(--primary-teal) !important;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-3 mb-4">
    <!-- Biểu đồ dòng tiền -->
    <div class="col-12 col-lg-8">
        <div class="dashboard-card">
            <div class="dashboard-card-title">
                <span><i class="bi bi-bar-chart-line text-primary me-2"></i>Biến động Thu - Chi 6 tháng gần nhất</span>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary active btn-sm" style="font-size: 12px;">Tháng</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" style="font-size: 12px;">Quý</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" style="font-size: 12px;">Năm</button>
                </div>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="cashFlowChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Biểu đồ cơ cấu chi tiêu -->
    <div class="col-12 col-lg-4">
        <div class="dashboard-card">
            <div class="dashboard-card-title">
                <span><i class="bi bi-pie-chart text-info me-2"></i>Cơ cấu chi tiêu tháng</span>
            </div>
            <div style="height: 220px; position: relative;" class="d-flex justify-content-center">
                <canvas id="expenseCategoryChart"></canvas>
            </div>
            <div class="mt-3 pt-2 border-top d-flex justify-content-around text-center" style="font-size: 12px;">
                <div><span class="badge bg-primary mb-1">Ăn uống</span><br><strong class="text-dark">35%</strong></div>
                <div><span class="badge bg-warning mb-1">Nhà ở</span><br><strong class="text-dark">25%</strong></div>
                <div><span class="badge bg-info mb-1">Mua sắm</span><br><strong class="text-dark">18%</strong></div>
                <div><span class="badge bg-secondary mb-1">Khác</span><br><strong class="text-dark">22%</strong></div>
            </div>
        </div>
    </div>
</div>

<!-- Transactions & Quick Tools Section -->
<div class="row g-3">
    <!-- Recent Transactions Table -->
    <div class="col-12 col-lg-8">
        <div class="dashboard-card">
            <div class="dashboard-card-title">
                <span><i class="bi bi-clock-history text-secondary me-2"></i>Lịch sử giao dịch gần đây</span>
                <a href="javascript:void(0)" class="text-decoration-none fw-semibold" style="font-size: 13px; color: var(--primary-teal);">Xem tất cả <i class="bi bi-chevron-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="table transaction-table">
                    <thead>
                        <tr>
                            <th>Giao dịch</th>
                            <th>Danh mục</th>
                            <th>Thời gian</th>
                            <th class="text-end">Số tiền</th>
                            <th class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="tx-icon-wrap" style="background: #e6f4ea; color: #137333;">
                                        <i class="bi bi-cash-stack"></i>
                                    </div>
                                    <div>
                                        <div class="tx-name">Nhận lương công ty</div>
                                        <div class="tx-category">Chuyển khoản VCB</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">Thu nhập</span></td>
                            <td class="text-muted" style="font-size: 12.5px;">Hôm nay, 08:30</td>
                            <td class="text-end tx-amount-plus">+65.000.000 ₫</td>
                            <td class="text-center"><span class="status-badge-success">Hoàn tất</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="tx-icon-wrap" style="background: #fce8e6; color: #c5221f;">
                                        <i class="bi bi-cart3"></i>
                                    </div>
                                    <div>
                                        <div class="tx-name">Siêu thị Mega Market</div>
                                        <div class="tx-category">Thực phẩm gia đình</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">Ăn uống</span></td>
                            <td class="text-muted" style="font-size: 12.5px;">Hôm qua, 18:45</td>
                            <td class="text-end tx-amount-minus">-2.450.000 ₫</td>
                            <td class="text-center"><span class="status-badge-success">Hoàn tất</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="tx-icon-wrap" style="background: #fce8e6; color: #c5221f;">
                                        <i class="bi bi-house-door"></i>
                                    </div>
                                    <div>
                                        <div class="tx-name">Thanh toán tiền thuê nhà</div>
                                        <div class="tx-category">Căn hộ Landmark</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">Nhà ở</span></td>
                            <td class="text-muted" style="font-size: 12.5px;">28/08/2026</td>
                            <td class="text-end tx-amount-minus">-12.000.000 ₫</td>
                            <td class="text-center"><span class="status-badge-success">Hoàn tất</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="tx-icon-wrap" style="background: #e6f4ea; color: #137333;">
                                        <i class="bi bi-graph-up-arrow"></i>
                                    </div>
                                    <div>
                                        <div class="tx-name">Cổ tức & Lãi trái phiếu</div>
                                        <div class="tx-category">Đầu tư chứng khoán</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">Đầu tư</span></td>
                            <td class="text-muted" style="font-size: 12.5px;">25/08/2026</td>
                            <td class="text-end tx-amount-plus">+15.200.000 ₫</td>
                            <td class="text-center"><span class="status-badge-success">Hoàn tất</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="tx-icon-wrap" style="background: #fce8e6; color: #c5221f;">
                                        <i class="bi bi-cup-hot"></i>
                                    </div>
                                    <div>
                                        <div class="tx-name">The Coffee House</div>
                                        <div class="tx-category">Gặp gỡ bạn bè</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">Giao lưu</span></td>
                            <td class="text-muted" style="font-size: 12.5px;">24/08/2026</td>
                            <td class="text-end tx-amount-minus">-280.000 ₫</td>
                            <td class="text-center"><span class="status-badge-success">Hoàn tất</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Tools & Bank Cards -->
    <div class="col-12 col-lg-4">
        <!-- Mock Virtual Credit Card -->
        <div class="mb-4 p-4 text-white" style="background: linear-gradient(135deg, #176e82 0%, #0d3b46 100%); border-radius: 18px; box-shadow: 0 10px 25px rgba(23, 110, 130, 0.35);">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="fw-bold fs-5 tracking-wider"><i class="bi bi-wallet2 me-2"></i>FinanceApp Card</span>
                <span class="badge bg-light text-dark px-2 py-1 fw-bold">PLATINUM</span>
            </div>
            <div class="fs-4 fw-bold mb-3 font-monospace tracking-widest">
                •••• •••• •••• 8899
            </div>
            <div class="d-flex justify-content-between align-items-end" style="font-size: 12px;">
                <div>
                    <div class="text-white-50">CHỦ THẺ</div>
                    <div class="fw-bold text-uppercase fs-6">@displayName</div>
                </div>
                <div>
                    <div class="text-white-50">HẠN DÙNG</div>
                    <div class="fw-bold fs-6">12/29</div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Grid -->
        <div class="dashboard-card">
            <div class="dashboard-card-title">
                <span><i class="bi bi-lightning-charge text-warning me-2"></i>Thao tác nhanh</span>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <a href="javascript:void(0)" class="btn-quick-action" data-bs-toggle="modal" data-bs-target="#newTransactionModal">
                        <i class="bi bi-plus-circle"></i>
                        <span>Thêm thu chi</span>
                    </a>
                </div>
                <div class="col-6">
                    <a href="javascript:void(0)" class="btn-quick-action" onclick="alert('Tính năng chuyển khoản!')">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Chuyển tiền</span>
                    </a>
                </div>
                <div class="col-6">
                    <a href="javascript:void(0)" class="btn-quick-action" onclick="alert('Tính năng tạo ví mục tiêu mới!')">
                        <i class="bi bi-bullseye"></i>
                        <span>Đặt mục tiêu</span>
                    </a>
                </div>
                <div class="col-6">
                    <a href="javascript:void(0)" class="btn-quick-action" onclick="alert('Mở camera quét mã QR thanh toán...')">
                        <i class="bi bi-qr-code-scan"></i>
                        <span>Quét mã QR</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Thêm giao dịch mới (Mock) -->
<div class="modal fade" id="newTransactionModal" tabindex="-1" aria-labelledby="newTransactionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="newTransactionModalLabel"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Thêm giao dịch mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="mockTransactionForm" onsubmit="event.preventDefault(); alert('Đã ghi nhận giao dịch thành công!'); var modal = bootstrap.Modal.getInstance(document.getElementById('newTransactionModal')); modal.hide();">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Loại giao dịch</label>
                        <div class="d-flex gap-2">
                            <input type="radio" class="btn-check" name="txType" id="typeExpense" checked>
                            <label class="btn btn-outline-danger w-50" for="typeExpense"><i class="bi bi-arrow-up-right me-1"></i> Khoản chi</label>

                            <input type="radio" class="btn-check" name="txType" id="typeIncome">
                            <label class="btn btn-outline-success w-50" for="typeIncome"><i class="bi bi-arrow-down-left me-1"></i> Khoản thu</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Số tiền (VNĐ)</label>
                        <input type="number" class="form-control form-control-lg" placeholder="500,000" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Danh mục</label>
                        <select class="form-select">
                            <option>Ăn uống & Sinh hoạt</option>
                            <option>Mua sắm & Giải trí</option>
                            <option>Nhà cửa & Tiện ích</option>
                            <option>Đi lại & Xăng xe</option>
                            <option>Tiết kiệm & Đầu tư</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Ghi chú giao dịch</label>
                        <input type="text" class="form-control" placeholder="Ví dụ: Ăn trưa với đồng nghiệp...">
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" style="background-color: var(--primary-teal); border: none; border-radius: 10px;">Lưu giao dịch</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Render Biểu đồ Dòng tiền 6 tháng
            const cashFlowCtx = document.getElementById('cashFlowChart').getContext('2d');
            new Chart(cashFlowCtx, {
                type: 'bar',
                data: {
                    labels: ['Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6', 'Tháng 7', 'Tháng 8'],
                    datasets: [
                        {
                            label: 'Thu nhập',
                            data: [85, 92, 110, 95, 118, 128.5],
                            backgroundColor: '#176e82',
                            borderRadius: 6
                        },
                        {
                            label: 'Chi tiêu',
                            data: [42, 38, 52, 44, 48, 45.2],
                            backgroundColor: '#ef4444',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: { family: 'Plus Jakarta Sans', size: 12 },
                                usePointStyle: true
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + context.parsed.y + ' triệu ₫';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value + 'M ₫';
                                }
                            },
                            grid: { color: '#f1f5f9' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });

            // Render Biểu đồ Cơ cấu Chi tiêu (Doughnut)
            const expenseCtx = document.getElementById('expenseCategoryChart').getContext('2d');
            new Chart(expenseCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Ăn uống', 'Nhà ở', 'Mua sắm', 'Khác'],
                    datasets: [{
                        data: [35, 25, 18, 22],
                        backgroundColor: ['#176e82', '#f59e0b', '#06b6d4', '#94a3b8'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    cutout: '70%'
                }
            });
        });
    </script>
}

